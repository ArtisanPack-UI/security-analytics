{
  "name": "artisanpack-ui/security-analytics",
  "description": "Security analytics for Laravel — security event logging, anomaly detection, threat intelligence, SIEM export (Splunk, Datadog, Elasticsearch, syslog), incident response, alerting, and dashboards.",
  "type": "library",
  "license": "MIT",
  "version": "1.2.0",
  "keywords": [
    "laravel",
    "security",
    "analytics",
    "siem",
    "anomaly-detection",
    "threat-intelligence",
    "incident-response",
    "audit-log",
    "monitoring"
  ],
  "autoload": {
    "psr-4": {
      "ArtisanPackUI\\SecurityAnalytics\\": "src/",
      "ArtisanPackUI\\SecurityAnalytics\\Database\\Factories\\": "database/factories/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jacob Martella",
      "email": "support@artisanpackui.dev"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "artisanpack-ui/ai": "^1.0.0-alpha.1",
    "artisanpack-ui/core": "^1.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../ai",
      "options": {
        "symlink": true
      }
    }
  ],
  "_comments": {
    "repositories": "The path repository to ../ai is a development-only convenience for the symlinked workflow used in the dev-app. On a fresh clone without the sibling ai checkout, composer install will fail to resolve artisanpack-ui/ai — that's expected for now; the package's release pipeline pulls it from Packagist via the ^1.0.0-alpha.1 constraint. CI removes this entry before installing."
  },
  "require-dev": {
    "artisanpack-ui/code-style": "^1.1",
    "artisanpack-ui/code-style-pint": "^1.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.75",
    "laravel/pint": "^1.26",
    "livewire/livewire": "^3.6|^4.0",
    "orchestra/testbench": "^10.2|^11.0",
    "pestphp/pest": "^3.8|^4.0",
    "pestphp/pest-plugin-laravel": "^3.2|^4.0"
  },
  "scripts": {
    "lint": [
      "./vendor/bin/php-cs-fixer fix --dry-run --diff",
      "./vendor/bin/phpcs"
    ],
    "fix": "./vendor/bin/php-cs-fixer fix",
    "cs": "./vendor/bin/phpcs",
    "cs:fix": "./vendor/bin/phpcbf",
    "test": "./vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ArtisanPackUI\\SecurityAnalytics\\SecurityAnalyticsServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
